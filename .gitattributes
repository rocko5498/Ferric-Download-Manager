# Force LF on checkout everywhere: rustfmt.toml pins newline_style = "Unix",
# and GitHub's Windows runners check out with autocrlf on — without this,
# `cargo fmt --check` fails on windows-latest before any code is inspected.
* text=auto eol=lf

# Binaries — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
*.db binary
*.mmdb binary
*.zip binary
*.gz binary
*.pdf binary
